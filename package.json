{
  "name": "fast-image-compression",
  "version": "1.0.0",
  "description": "Fast online image compression tool",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:e2e:watch": "jest --config jest.e2e.config.js --watch",
    "test:e2e:docker": "jest --config jest.e2e.docker.config.js",
    "test:e2e:safe": "docker-compose -f docker-compose.testing.yml up --build --abort-on-container-exit",
    "test:all": "npm run test && npm run test:e2e",
    "test:all:safe": "npm run test && npm run test:e2e:safe",
    "serve": "python -m http.server 8000",
    "serve:node": "npx http-server -p 8000",
    "test:a11y": "pa11y-ci --config .pa11yci.json",
    "docker:build": "docker build -f Dockerfile.testing -t image-compression-tests .",
    "docker:test": "docker run --rm -v $(pwd):/app -w /app image-compression-tests npm run test:e2e:docker",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "links:related-guides": "node scripts/add-related-guides.mjs"
  },
  "keywords": [
    "image-compression",
    "photo-compressor",
    "web-app",
    "canvas",
    "javascript"
  ],
  "author": "Fast Image Compression",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.1.3",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.1.2",
    "jest-puppeteer": "^11.0.0",
    "pa11y-ci": "^4.0.1",
    "puppeteer": "^24.22.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js",
      "<rootDir>/tests/integration/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "script.js",
      "!**/node_modules/**",
      "!**/tests/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
